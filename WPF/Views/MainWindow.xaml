<Window x:Class="RentCarWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RentCarWPF.ViewModels"
        Title="🚗 Rent Car – Rapoarte WPF"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F8FC">

    <!-- DataContext = sursa tuturor binding-urilor (Lab 9) -->
    <Window.DataContext>
        <local:RapoarteViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#2E75B6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
        <Style TargetType="Button" x:Key="SuccessBtn" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#27AE60"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="Padding"    Value="6,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Add form -->
            <RowDefinition Height="48"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1F3864">
            <DockPanel Margin="16,0">
                <TextBlock DockPanel.Dock="Left"
                           Text="🚗 Rent Car – Rapoarte Rezervări"
                           FontSize="16" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SuccessBtn}"
                            Content="💾 Exportă raport"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,8,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Content: Lista + Detalii ════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista rezervari (Lab 9 – Binding ItemsSource, SelectedItem) -->
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top"
                           Text="Lista rezervări"
                           FontWeight="Bold" FontSize="13"
                           Foreground="#1F3864"
                           Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Rezervari, Mode=OneWay}"
                         SelectedItem="{Binding RezervareSelectata, Mode=TwoWay}"
                         DisplayMemberPath="Descriere"
                         FontFamily="Segoe UI" FontSize="11"
                         BorderBrush="#BDC3C7"
                         HorizontalContentAlignment="Stretch"/>
            </DockPanel>

            <!-- Detalii rezervare selectata -->
            <StackPanel Grid.Column="1" Margin="8">
                <TextBlock Text="Rezervare selectată"
                           FontWeight="Bold" FontSize="13"
                           Foreground="#1F3864"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Client (Lab 9 – TwoWay binding cu UpdateSourceTrigger) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Client:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,3"
                               Style="{StaticResource InputBox}"
                               Text="{Binding RezervareSelectata.Client,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Vehicul:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,3"
                               Style="{StaticResource InputBox}"
                               Text="{Binding RezervareSelectata.Vehicul,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Stare:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,3"
                               Style="{StaticResource InputBox}"
                               Text="{Binding RezervareSelectata.Stare,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Perioadă:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="6,4"
                               Text="{Binding RezervareSelectata.Perioada, Mode=OneWay}"
                               FontStyle="Italic" Foreground="#555"/>

                    <!-- Rating Slider (Lab 9 pattern) -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Rating:" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <Slider Value="{Binding RezervareSelectata.Rating, Mode=TwoWay}"
                                Minimum="0" Maximum="10"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RezervareSelectata.RatingText, Mode=OneWay}"
                                   Margin="8,0" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="#1F3864"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Cost total:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="6,4"
                               Text="{Binding RezervareSelectata.CostText, Mode=OneWay}"
                               FontSize="14" FontWeight="Bold" Foreground="#1F3864"/>
                </Grid>

                <Separator Margin="0,10"/>

                <Button Style="{StaticResource DangerBtn}"
                        Content="🗑 Șterge rezervarea"
                        Command="{Binding StergeCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,4"/>
            </StackPanel>
        </Grid>

        <!-- ══ Add Form (Lab 9 – form cu binding OneWay/TwoWay) ════════ -->
        <Border Grid.Row="2" Background="#E8F0FA" Padding="12,8" Margin="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Client:"  VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox   Grid.Column="1" Margin="0,0,12,0"
                           Style="{StaticResource InputBox}"
                           Text="{Binding NouClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="2" Text="Vehicul:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox   Grid.Column="3" Margin="0,0,12,0"
                           Style="{StaticResource InputBox}"
                           Text="{Binding NouVehicul, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="4" Text="Zile:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox   Grid.Column="5" Margin="0,0,12,0"
                           Style="{StaticResource InputBox}"
                           Text="{Binding NouAn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button    Grid.Column="6"
                           Style="{StaticResource SuccessBtn}"
                           Content="➕ Adaugă rezervare"
                           Command="{Binding AdaugaCommand}"/>
            </Grid>
        </Border>

        <!-- ══ Footer – statistici (Lab 9 – OneWay binding) ════════════ -->
        <Border Grid.Row="3" Background="#1F3864" Padding="16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding TotalText, Mode=OneWay}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#F1C40F"
                           VerticalAlignment="Center"/>
                <TextBlock Text="📊 Raport generat automat prin data binding WPF (MVVM – Lab 9)"
                           FontSize="10" FontStyle="Italic"
                           Foreground="#BDC3C7"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
